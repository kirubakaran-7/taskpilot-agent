# Copy this file to ".env" and fill in your values.

# Which backend to use: "openai" or "ollama"
BACKEND=openai

# Required only if BACKEND=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# Used only if BACKEND=ollama (needs a local Ollama server + a tool-calling model)
OLLAMA_CHAT_MODEL=llama3.1
